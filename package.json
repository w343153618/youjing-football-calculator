{
  "name": "youjing-football-calculator",
  "private": true,
  "version": "2.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/obfuscate-dist.mjs",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "bench:quant": "node scripts/bench-quant.mjs",
    "check:guardrails": "node scripts/check-guardrails.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.10.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
